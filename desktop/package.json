{
  "name": "meowtoko-e7-tool-desktop",
  "productName": "Meowtoko E7 Tool",
  "version": "0.1.38",
  "description": "Desktop analyzer and enhancement companion for Epic Seven gear",
  "author": "Meowtoko E7 Tool contributors",
  "license": "UNLICENSED",
  "homepage": "https://github.com/Motokochi/Meowtoko-E7-Tool",
  "repository": {
    "type": "git",
    "url": "https://github.com/Motokochi/Meowtoko-E7-Tool.git"
  },
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build:characters": "node scripts/build-character-artwork.cjs",
    "build:cuda-installer": "node scripts/build-cuda-installer.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "cleanup:build": "node ../scripts/cleanup-build-output.cjs",
    "cleanup:releases": "node ../scripts/cleanup-release-archives.cjs",
    "audit:legacy": "node scripts/audit-legacy-retirement.cjs",
    "audit:package": "node scripts/audit-package.cjs",
    "audit:installer": "node scripts/audit-installer.cjs",
    "smoke:package": "node scripts/smoke-packaged.cjs",
    "smoke:single-instance": "node scripts/smoke-single-instance.cjs",
    "smoke:single-instance:dev": "node scripts/smoke-single-instance.cjs --development",
    "test": "pnpm run audit:legacy && pnpm run test:cleanup && pnpm run test:repository && pnpm run test:desktop",
    "test:cleanup": "node --test ../scripts/cleanup-contract.test.cjs",
    "test:repository": "node --test ../scripts/documentation-contract.test.cjs ../scripts/release-contract.test.cjs ../scripts/stage-github-release.test.cjs ../scripts/workflow-contract.test.cjs",
    "docs:validate": "node ../scripts/validate-documentation.cjs",
    "docs:capture": "node ../scripts/capture-readme.cjs",
    "release:verify": "node ../scripts/release-contract.cjs",
    "release:prepare": "node ../scripts/prepare-release.cjs",
    "test:desktop": "tsc -p tsconfig.tests.json && node --require ./scripts/register-test-assets.cjs --test ../.build/desktop-tests/analyzer.test.js ../.build/desktop-tests/analyzer-center.test.js ../.build/desktop-tests/enhancement.test.js ../.build/desktop-tests/enhancer-center.test.js ../.build/desktop-tests/backend-client.test.js ../.build/desktop-tests/backend-launch.test.js ../.build/desktop-tests/character-artwork.test.js ../.build/desktop-tests/desktop-api.test.js ../.build/desktop-tests/health.test.js ../.build/desktop-tests/health-center.test.js ../.build/desktop-tests/gear-center.test.js ../.build/desktop-tests/theme.test.js ../.build/desktop-tests/navigation.test.js ../.build/desktop-tests/app-shell.test.js ../.build/desktop-tests/app.test.js ../.build/desktop-tests/optimizer-inventory.test.js ../.build/desktop-tests/optimizer-inventory-dialog.test.js ../.build/desktop-tests/importer-center.test.js ../.build/desktop-tests/optimizer-profile.test.js ../.build/desktop-tests/optimizer-profile-editor.test.js ../.build/desktop-tests/optimizer-center.test.js ../.build/desktop-tests/optimizer-search.test.js ../.build/desktop-tests/optimizer-results.test.js ../.build/desktop-tests/ui.test.js ../.build/desktop-tests/security-config.test.js ../.build/desktop-tests/settings.test.js ../.build/desktop-tests/settings-center.test.js ../.build/desktop-tests/squirrel-lifecycle.test.js ../.build/desktop-tests/update-service.test.js ../.build/desktop-tests/update-center.test.js ../.build/desktop-tests/window-lifecycle.test.js",
    "typecheck": "tsc --noEmit",
    "package": "pnpm run audit:legacy && pnpm run build:characters && pnpm run build:cuda-installer && pnpm run build:backend && electron-forge package && pnpm run audit:package",
    "make": "pnpm run audit:legacy && pnpm run build:characters && pnpm run build:cuda-installer && pnpm run build:backend && electron-forge make && pnpm run audit:package && pnpm run audit:installer && node scripts/publish-local-release.cjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "css-loader": "7.1.4",
    "electron": "43.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1"
  },
  "packageManager": "pnpm@11.9.0"
}
